{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@messenger/protocol": ["packages/protocol/ts/src/index.ts"],
      "@messenger/crypto": ["packages/crypto/ts/src/index.ts"],
      "@messenger/transport": ["packages/transport/ts/src/index.ts"]
    }
  }
}
